# Plantilla de configuración de Roboflow.
#
# 1. Copia este archivo como ".env" en la misma carpeta:
#      cp .env.example .env
# 2. Completa tus valores reales en ".env".
# 3. NO subas ".env" a git (ya está protegido en .gitignore).

PINCHER_API_KEY=tu_api_key_aqui
PINCHER_MODEL_ID=tu-proyecto/1
PINCHER_API_BACKEND=roboflow
